{
  "name": "SkillRecord",
  "type": "object",
  "properties": {
    "volunteer_email": {
      "type": "string"
    },
    "volunteer_name": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "event",
        "learning",
        "self",
        "cv"
      ],
      "default": "event"
    },
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "organisation_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "volunteer_email",
    "skill"
  ]
}